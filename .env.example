# Copy this file to .env (same folder) and paste your keys after the = sign.
# .env is in .gitignore, so it never gets committed. Never put real keys in this file.

# Google Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Grok (xAI) key: https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4

# Groq key (groq.com, starts with gsk_): https://console.groq.com/keys
# Groq is NOT Grok. It runs open models fast; change GROQ_MODEL to any model Groq lists.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# TypeSafe AI (Jev) key: https://console.typesafe.ai/keys
# Gives a typed second opinion on each plan (see jev.py). Optional.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Which model writes the ANALYST plan: gemini, grok or groq
DESK_PROVIDER=gemini
